{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "types": [],
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": ["./src/*"],
      "@liveagent/app/*": ["./src/*"],
      "@liveagent/adapters/*": ["./src/agent-ui-adapters/*"],
